<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hospital.mapper.UserMapper">

    <select id="selectByUsername"
            resultType="com.hospital.entity.User">

        select *
        from users
        where username = #{username}

    </select>

    <select id="selectAll" resultType="com.hospital.entity.User">
        select * from users;

    </select>

    <select id="selectById" resultType="com.hospital.entity.User">
        select * from users where id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true"
            keyProperty="id">

        insert into users
        (
        username,
        password,
        role,
        create_time,
        update_time
        )
        values
        (
        #{username},
        #{password},
        #{role},
        #{createTime},
        #{updateTime}
        )

    </insert>

    <update id="update">

        update users

        set username=#{username},
        password=#{password},
        role=#{role},
        update_time=#{updateTime}

        where id=#{id}

    </update>


    <update id="updatePasswordById">

        update users

        set password=#{password},
            update_time=#{updateTime},
            token_version = token_version + 1

        where id=#{id}

    </update>


    <delete id="deleteById">

        delete from users
        where id=#{id}

    </delete>

</mapper>
