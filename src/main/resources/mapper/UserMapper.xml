<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hospital.mapper.UserMapper">

    <select id="selectByUsername"
            resultType="com.hospital.entity.User">

        select *
        from users
        where username = #{username}

    </select>

    <select id="selectAll" resultType="com.hospital.entity.User">
        select * from users;

    </select>

    <select id="selectById" resultType="com.hospital.entity.User">
        select * from users where id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true"
            keyProperty="id">

        insert into users
        (
        username,
        password,
        role,
        create_time,
        update_time
        )
        values
        (
        #{username},
        #{password},
        #{role},
        #{createTime},
        #{updateTime}
        )

    </insert>

    <update id="update">

        update users

        <set>
            <if test="username != null">
                username = #{username},
            </if>

            <if test="password != null">
                password = #{password},
            </if>

            <if test="role != null">
                role=#{role},
            </if>

            update_time=#{updateTime}
        </set>




        where id=#{id}

    </update>

    <select id="selectByIds" resultType="com.hospital.entity.User">
        select * from users
        where id in
        <foreach collection="ids"
                 item="id"
                 open="("
                 separator=","
                 close=")">
            #{id}
        </foreach>
    </select>

    <insert id="batchInsert">

        insert into users
        (
        username,
        password,
        role
        )

        values

        <foreach collection="users"
                 item="user"
                 separator=",">

            (
            #{user.username},
            #{user.password},
            #{user.role}
            )

        </foreach>

    </insert>

    <delete id="deleteById">

        delete from users
        where id=#{id}

    </delete>

    <select id="selectList" resultType="com.hospital.entity.User">
        select * from users
        <where>
            <if test="username!=null">
                and username = #{username}
            </if>

            <if test="role != null">
                and role = #{role}
            </if>


        </where>
    </select>

</mapper>
